            <vm:ViewModelLocator
                xmlns:vm="clr-namespace:UI.Test.ViewModels"
                x:Key="Locator"
                d:IsDataSource="True" />

            <Style TargetType="Window">
                <Setter Property="FontSize" Value="28" />
