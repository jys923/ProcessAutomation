        <DataTemplate DataType="{x:Type viewmodels:TestListViewModel}">
            <views:TestListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TestViewModel}">
            <views:TestView/>
        </DataTemplate>-->
