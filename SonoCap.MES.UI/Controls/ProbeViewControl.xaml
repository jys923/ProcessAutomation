                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg02}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg02}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg02}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg02}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg10}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg10}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg10}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg10}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg11}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg11}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg11}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg11}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="3" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg12}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg12}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg12}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg12}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg20}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg20}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg20}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg20}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="3" Grid.Column="2" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg21}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg21}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg21}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg21}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="3" Grid.Column="3" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg22}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg22}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg22}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg22}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0 0 -5 0" >
            <StackPanel Orientation="Horizontal">
                <Button Width="100" Command="{Binding DeleteCommand}" Content="Del" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="30" Style="{StaticResource MetroBlueButtonStyle}" />
                <Button Width="100" Content="Close" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="30" IsCancel="True" Cursor="Hand" Style="{StaticResource MetroPinkButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
