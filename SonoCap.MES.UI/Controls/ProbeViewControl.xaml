<UserControl x:Class="SonoCap.MES.UI.Controls.ProbeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SonoCap.MES.UI.Controls"
             mc:Ignorable="d" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             Loaded="UserControl_Loaded"
             d:DesignHeight="960" d:DesignWidth="1400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource BaseFontStyle}">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MetroTextBoxStyle}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10 10 10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height=".2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height=".1*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Row="0" Content="검사 시간"/>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Row="1" Content="Probe Sn"/>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Row="2" Content="TD Sn"/>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Row="3" Content="TDMd Sn"/>
            <TextBlock Style="{StaticResource TextBlockMediumStyle}" Text="{Binding PTRView.CreatedDate, StringFormat='yyyy-MM-dd HH:mm'}" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Style="{StaticResource TextBlockMediumStyle}" Text="{Binding PTRView.ProbeSn}" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Style="{StaticResource TextBlockMediumStyle}" Text="{Binding PTRView.TransducerSn}" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Style="{StaticResource TextBlockMediumStyle}" Text="{Binding PTRView.TransducerModuleSn}" Grid.Row="3" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0 10 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource CellHeaderBrush}"/>
            
            <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource CellHeaderBrush}"/>
            <Border Grid.Column="0" Grid.Row="2" Background="{StaticResource CellHeaderBrush}"/>
            <Border Grid.Column="0" Grid.Row="3" Background="{StaticResource CellHeaderBrush}"/>

            <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource CellHeaderBrush}"/>
            <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource CellHeaderBrush}"/>
            <Border Grid.Column="3" Grid.Row="0" Background="{StaticResource CellHeaderBrush}"/>

            <Label Style="{StaticResource LabelMediumStyle}" Grid.Column="1" HorizontalAlignment="Center" Content="Align"/>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Column="2" HorizontalAlignment="Center" Content="Axial"/>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Column="3" HorizontalAlignment="Center" Content="Leteral"/>

            <Label Style="{StaticResource LabelMediumStyle}" Grid.Row="1" Height="40" Width="120" RenderTransformOrigin="0.5,0.5" Margin="-40 0 0 0" Content="공정">
                <Label.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </Label.RenderTransform>
            </Label>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Row="2" Height="40" Width="120" RenderTransformOrigin="0.5,0.5" Margin="-40 0 0 0" Content="완제품">
                <Label.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </Label.RenderTransform>
            </Label>
            <Label Style="{StaticResource LabelMediumStyle}" Grid.Row="3" Height="40" Width="120" RenderTransformOrigin="0.5,0.5" Margin="-40 0 0 0" Content="최종">
                <Label.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </Label.RenderTransform>
            </Label>

            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg00}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding SrcImg00}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
                <Viewbox Grid.Column="1" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding ResImg00}">
                        <Image.ToolTip>
                            <ToolTip>
                                <Image Source="{Binding ResImg00}" Stretch="UniformToFill" Width="500" Height="500"/>
                            </ToolTip>
                        </Image.ToolTip>
                    </Image>
                </Viewbox>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Margin="2.5 0 2.5 0">
                    <Image Stretch="UniformToFill" Source="{Binding SrcImg01}">
                        <Image.ToolTip>
                            <ToolTip>
