<Window x:Class="SonoCap.MES.UI.Views.FirstView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SonoCap.MES.UI.Views"
        xmlns:Converter="clr-namespace:SonoCap.MES.UI.Converters"
        xmlns:Behavior="clr-namespace:SonoCap.MES.UI.Behaviors"
        xmlns:vm="clr-namespace:SonoCap.MES.UI.ViewModels"
        WindowState="Maximized"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type vm:FirstViewModel}}" Title="{Binding Title}" Height="1080" Width="1920">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="1" Source="{Binding Logo}"/>
        <Grid Height="50" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" ShowGridLines="true">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Testing" FontSize="15" Margin="5" IsDefault="True" Command="{Binding GoTestingViewCommand}" /> 
            <Button Grid.Column="1" Content="TestList" FontSize="15" Margin="5" IsDefault="True" Command="{Binding GoTestListViewCommand}" />
            <Button Grid.Column="2" Content="ProbeList" FontSize="15" Margin="5" IsDefault="True" Command="{Binding GoProbeListViewCommand}" /> 
        </Grid>
    </Grid>
</Window>
