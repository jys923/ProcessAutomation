            <GroupBox Grid.Row="1" Header="ViewDepth" Style="{StaticResource GroupBoxLargeStyle}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="3" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=3}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding DepthIsEnabled[0].IsEnabled}" />
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="4" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=4}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding DepthIsEnabled[1].IsEnabled}" />
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="5" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=5}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding DepthIsEnabled[2].IsEnabled}" />
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="6" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=6}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding DepthIsEnabled[3].IsEnabled}" />
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="7" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=7}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding DepthIsEnabled[4].IsEnabled}" />
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="LineDensity" Style="{StaticResource GroupBoxLargeStyle}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="LineDensityGroup" Content="1" IsChecked="{Binding SelectedLineDensity, Mode=TwoWay, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=1}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding LineDensityIsEnabled[0].IsEnabled}" />
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="LineDensityGroup" Content="2" IsChecked="{Binding SelectedLineDensity, Mode=TwoWay, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=2}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding LineDensityIsEnabled[1].IsEnabled}" />
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="LineDensityGroup" Content="3" IsChecked="{Binding SelectedLineDensity, Mode=TwoWay, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=3}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding LineDensityIsEnabled[2].IsEnabled}" />
                    <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="LineDensityGroup" Content="4" IsChecked="{Binding SelectedLineDensity, Mode=TwoWay, Converter={StaticResource IntToBooleanConverter}, ConverterParameter=4}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding LineDensityIsEnabled[3].IsEnabled}" />
                </StackPanel>
            </GroupBox>
            <Border Height="0" />
            <GroupBox Header="Power" Style="{StaticResource GroupBoxLargeStyle}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Width="500">
                    <Slider Width="450" Minimum="30" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding SelectedPower, Mode=TwoWay}" Height="30" />
                    <TextBlock Text="{Binding SelectedPower, StringFormat={}{0:000}}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </GroupBox>
            <Border Height="0" />
            <GroupBox Header="IPGain" Style="{StaticResource GroupBoxLargeStyle}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Width="500">
                    <Slider Width="450" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding IPGain, Mode=TwoWay}" Height="30" />
                    <TextBlock Text="{Binding IPGain, StringFormat={}{0:000}}" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </GroupBox>
            <Border Height="0" />
            <GroupBox Header="DR min max" Style="{StaticResource GroupBoxLargeStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <mah:RangeSlider MinRangeWidth="0" Width="500" mah:SliderHelper.ChangeValueBy="LargeChange" mah:SliderHelper.EnableMouseWheel="MouseHover" AutoToolTipPlacement="TopLeft" LargeChange="10" LowerValue="{Binding DRMin}" Maximum="100" Minimum="0" Orientation="Horizontal" SmallChange="1" Style="{DynamicResource MahApps.Styles.RangeSlider.Win10}" UpperValue="{Binding DRMax}" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30">
                        <mah:RangeSlider.AutoToolTipRangeValuesTemplate>
                            <DataTemplate DataType="mah:RangeSliderAutoTooltipValues">
                                <UniformGrid Columns="2" Rows="2">
                                    <TextBlock HorizontalAlignment="Right" Text="From:" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding LowerValue, StringFormat={}{0:000}}" />
                                    <TextBlock HorizontalAlignment="Right" Text="To:" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding UpperValue, StringFormat={}{0:000}}" />
                                </UniformGrid>
                            </DataTemplate>
                        </mah:RangeSlider.AutoToolTipRangeValuesTemplate>
                    </mah:RangeSlider>
                    <TextBlock Text="{Binding DRMin, StringFormat={}{0:000}}" Margin="5,0,0,0" FontWeight="Normal" VerticalAlignment="Center" />
                    <TextBlock Text="-" Margin="5,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DRMax, StringFormat={}{0:000}}" Margin="5,0,0,0" FontWeight="Normal" VerticalAlignment="Center" />
                </StackPanel>
            </GroupBox>
            <Border Height="0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Calibration" Style="{StaticResource GroupBoxLargeStyle}" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBox TextWrapping="Wrap" Text="{Binding CalibrationOffset}" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Content="Set" Command="{Binding CalibrateButtonCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Setting" Style="{StaticResource GroupBoxLargeStyle}" HorizontalAlignment="Stretch" Grid.Column="1">
                    <ComboBox ItemsSource="{Binding SubSettingList}" DisplayMemberPath="Item2" SelectedItem="{Binding SelectedSubSetting}" Width="100" Height="30" VerticalAlignment="Center" Margin="10" HorizontalAlignment="Center" />
                </GroupBox>
            </Grid>
        </StackPanel>
        <GroupBox Grid.Row="2" VerticalAlignment="Bottom" Style="{StaticResource RemoveGroupBoxBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" FontSize="40" Background="LightBlue" Content="검 사" Command="{Binding TestCommand}" />
                <!--<Border Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{Binding TestResult, Converter={StaticResource TestResultBorderBrushConverter}}" BorderThickness="2" >-->
                <Border Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{Binding ValidationDict[TestResult].IsEnabled, Converter={StaticResource TestResultBorderBrushConverter}}" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Style="{StaticResource RadioButtonLargeStyle}" GroupName="TestResultGroup" Content="FAIL" IsChecked="{Binding TestResult, ConverterParameter=-1, Converter={StaticResource RadioButtonIndexConverter}, Mode=TwoWay}" HorizontalContentAlignment="Center" Background="Tomato" Margin="20,0,0,0" IsEnabled="{Binding ValidationDict[TestResult].IsEnabled}" />
                        <RadioButton Grid.Column="1" Style="{StaticResource RadioButtonLargeStyle}" GroupName="TestResultGroup" Content="PASS" IsChecked="{Binding TestResult, ConverterParameter=100, Converter={StaticResource RadioButtonIndexConverter}, Mode=TwoWay}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" IsEnabled="{Binding ValidationDict[TestResult].IsEnabled}" />
                    </Grid>
                </Border>
                <Button Grid.Column="3" FontSize="40" Background="LightBlue" Content="저 장" Command="{Binding NextCommand}" />
            </Grid>
        </GroupBox>
        <GroupBox Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource RemoveGroupBoxBorder}">
            <StackPanel>
                <TextBlock Text="" FontSize="35" Foreground="DarkSlateGray" FontFamily="Digital-7" />
                <Label Style="{StaticResource LabelLargeStyle}" HorizontalContentAlignment="Center" Margin="0,0,0,15" Content="초 음 파  영 상" />
                <Grid>
                    <Image x:Name="SnapshotImg" Stretch="None" Source="{Binding SnapshotImg}" Width="512" Height="512" />
                    <Image x:Name="SrcImg" Stretch="None" Source="{Binding SrcImg}" Width="512" Height="512" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Style="{StaticResource GroupBoxLargeStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="1" Grid.Row="2" Margin="0,0,0,0" Header="검사 결과">
            <TextBlock Background="Transparent" Margin="10" TextWrapping="Wrap" x:Name="TestResTb" Text="{Binding ResTxt}" />
        </GroupBox>
        <GroupBox Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource RemoveGroupBoxBorder}">
            <StackPanel>
                <TextBlock Text="{Binding CurrentTime}" FontSize="35" Foreground="DarkSlateGray" FontFamily="Digital-7" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Label Panel.ZIndex="1" Style="{StaticResource LabelLargeStyle}" HorizontalContentAlignment="Center" Margin="0,0,0,15" Content="결 과 이 미 지" />
                <Image Width="512" Height="512" x:Name="ResImg" Source="{Binding ResImg}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Style="{StaticResource GroupBoxLargeStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="2" Grid.Row="2" Grid.RowSpan="1" Margin="0,0,0,0" Header="검사 기록">
            <ListBox Margin="15" Padding="10" ItemsSource="{Binding ResLogs}" SelectedItem="{Binding SelectedLogItem}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseDoubleClick">
                        <b:InvokeCommandAction Command="{Binding CopyLogCommand}" CommandParameter="{Binding SelectedLogItem}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <b:Interaction.Behaviors>
                    <behaviors:ScrollToEndBehavior />
                </b:Interaction.Behaviors>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
