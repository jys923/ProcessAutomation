<Window x:Class="SonoCap.MES.PreviewUI.Views.PreviewSaveView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:SonoCap.MES.PreviewUI.Views" xmlns:vm="clr-namespace:SonoCap.MES.PreviewUI.ViewModels" mc:Ignorable="d" WindowState="Maximized" d:DataContext="{d:DesignInstance Type={x:Type vm:PreviewSaveViewModel}}" Title="{Binding Title}" Height="1080" Width="1920" xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" PreviewMouseDown="Window_PreviewMouseDown" Focusable="True" xmlns:Behavior="clr-namespace:SonoCap.WpfCommons.Behaviors;assembly=SonoCap.WpfCommons">

    <Window.Resources>
    </Window.Resources>
    <!--<Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding KeyDownCommand}"/>
    </Window.InputBindings>-->
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="KeyDown">
            <b:InvokeCommandAction Command="{Binding KeyDownCommand}" PassEventArgsToCommand="True">
            </b:InvokeCommandAction>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid x:Name="MainGrid" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <!-- 중앙에 표시될 Popup -->
        <Popup x:Name="popupMessage" Width="200" Height="100" AllowsTransparency="True" PopupAnimation="Fade" HorizontalAlignment="Center" VerticalAlignment="Center" Placement="Center" PlacementTarget="{Binding ElementName=MainGrid}" IsOpen="{Binding MessageIsPopupOpen}">
            <Grid Background="Transparent">
                <!-- 배경을 투명으로 설정 -->
                <Border Background="LightGray" CornerRadius="50" Opacity="0.5">
                    <TextBlock Text="{Binding Path=Message}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
                </Border>
            </Grid>
        </Popup>

        <Grid Grid.Column="0" Grid.RowSpan="2" Grid.Row="0" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Top -->
                <RowDefinition Height="*" />
                <!-- Spacer -->
                <RowDefinition Height="Auto" />
                <!-- Bottom -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0">

                <GroupBox Grid.Row="1" Header="ViewDepth" Style="{StaticResource GroupBoxLargeStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="3" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=3}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" />
                        <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="4" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=4}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" />
                        <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="5" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=5}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" />
                        <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="6" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=6}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" />
                        <RadioButton Style="{StaticResource RadioButtonLargeStyle}" GroupName="ViewDepthGroup" Content="7" IsChecked="{Binding SelectedViewDepth, Mode=TwoWay, Converter={StaticResource DoubleToBooleanConverter}, ConverterParameter=7}" HorizontalContentAlignment="Center" Background="LightGreen" Margin="20,0,0,0" />
                    </StackPanel>
                </GroupBox>
                <Border Height="0" />
                <GroupBox Header="Power" Style="{StaticResource GroupBoxLargeStyle}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Width="500">
                        <Slider Width="450" Minimum="30" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding SelectedPower, Mode=TwoWay}" Height="30" />
                        <TextBlock Text="{Binding SelectedPower, StringFormat={}{0:000}}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </GroupBox>
                <Border Height="0" />
                <GroupBox Header="IPGain" Style="{StaticResource GroupBoxLargeStyle}">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Width="500">
                        <Slider Width="450" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding IPGain, Mode=TwoWay}" Height="30" />
                        <TextBlock Text="{Binding IPGain, StringFormat={}{0:000}}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </GroupBox>
                <Border Height="0" />
                <GroupBox Header="DR min max" Style="{StaticResource GroupBoxLargeStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <mah:RangeSlider MinRangeWidth="0" Width="500" mah:SliderHelper.ChangeValueBy="LargeChange" mah:SliderHelper.EnableMouseWheel="MouseHover" AutoToolTipPlacement="TopLeft" LargeChange="10" LowerValue="{Binding DRMin}" Maximum="100" Minimum="0" Orientation="Horizontal" SmallChange="1" Style="{DynamicResource MahApps.Styles.RangeSlider.Win10}" UpperValue="{Binding DRMax}" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30">
                            <mah:RangeSlider.AutoToolTipRangeValuesTemplate>
                                <DataTemplate DataType="mah:RangeSliderAutoTooltipValues">
                                    <UniformGrid Columns="2" Rows="2">
                                        <TextBlock HorizontalAlignment="Right" Text="From:" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding LowerValue, StringFormat={}{0:000}}" />
                                        <TextBlock HorizontalAlignment="Right" Text="To:" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding UpperValue, StringFormat={}{0:000}}" />
                                    </UniformGrid>
                                </DataTemplate>
                            </mah:RangeSlider.AutoToolTipRangeValuesTemplate>
                        </mah:RangeSlider>
                        <TextBlock Text="{Binding DRMin, StringFormat={}{0:000}}" Margin="5,0,0,0" FontWeight="Normal" VerticalAlignment="Center" />
                        <TextBlock Text="-" Margin="5,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DRMax, StringFormat={}{0:000}}" Margin="5,0,0,0" FontWeight="Normal" VerticalAlignment="Center" />
                    </StackPanel>
                </GroupBox>
                <Border Height="0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Visibility="Hidden" Header="Calibration" Style="{StaticResource GroupBoxLargeStyle}" Grid.Column="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBox TextWrapping="Wrap" Text="{Binding CalibrationOffset}" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Button Content="Set" Command="{Binding CalibrateButtonCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Setting" Style="{StaticResource GroupBoxLargeStyle}" HorizontalAlignment="Stretch" Grid.Column="1">
                        <ComboBox ItemsSource="{Binding SubSettingList}" DisplayMemberPath="Item2" SelectedItem="{Binding SelectedSubSetting}" Width="100" Height="30" VerticalAlignment="Center" Margin="10" HorizontalAlignment="Center" />
                    </GroupBox>
                </Grid>
                <TextBlock Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="20" Text="{Binding NoiseLog}" Margin="0,10,0,0" TextWrapping="Wrap" d:Text="디자이너에서만 보이는&#x0a;더미 텍스트입니다." />
            </StackPanel>
            <GroupBox Grid.Row="2" VerticalAlignment="Bottom" Style="{StaticResource RemoveGroupBoxBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>

                    <!-- 파일명 표시 -->
                    <TextBox Margin="0,0,10,0" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0" FontSize="20" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding SerialNumber}" />

                    <TextBlock Grid.ColumnSpan="2" Grid.Column="2" Grid.Row="0" FontSize="20" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding RecordingTimeText}" />

                    <!-- 캡처 버튼 -->
                    <Button Grid.Column="0" Grid.Row="1" FontSize="40" Background="LightBlue" Content="📸" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CaptureCommand}" />

                    <!-- 녹화 버튼 -->
                    <Button Grid.Column="2" Grid.Row="1" FontSize="40" Background="LightSalmon" Content="{Binding RecordButtonText}" Command="{Binding RecordCommand}" IsEnabled="{Binding IsRecordEnabled}" />

                    <!-- 정지 버튼 -->
                    <Button Grid.Column="3" Grid.Row="1" FontSize="40" Background="LightGray" Content="⏹" Command="{Binding StopCommand}" IsEnabled="{Binding IsStopEnabled}" />
                </Grid>
            </GroupBox>

        </Grid>

        <GroupBox Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource RemoveGroupBoxBorder}">
            <StackPanel>
                <Label Visibility="Visible" Style="{StaticResource LabelLargeStyle}" HorizontalContentAlignment="Center" Margin="0,0,0,15" Content="초 음 파  영 상" />
                <Grid>
                    <Image x:Name="SnapshotImg" Stretch="Fill" Source="{Binding SnapshotImg}" Width="900" Height="900" />
                    <Image x:Name="SrcImg" Stretch="Fill" Source="{Binding SrcImg}" Width="900" Height="900" Focusable="True" Cursor="Hand" MouseDown="SrcImg_MouseDown">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="KeyDown">
                                <b:InvokeCommandAction Command="{Binding KeyDownCommand}" PassEventArgsToCommand="True" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </Image>
                </Grid>
            </StackPanel>
        </GroupBox>
        <materialDesign:Snackbar Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" MessageQueue="{Binding MessageQueue}" Name="MainSnackbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" />
    </Grid>
</Window>